generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccommodationType {
  guesthouse
  eco_camp
  green_hotel
}

enum BookingStatus {
  pending
  confirmed
  rejected
  cancelled
  completed
}

enum MessageStatus {
  new
  read
  archived
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Destination {
  id               String             @id @default(cuid())
  slug             String             @unique
  wilaya           String
  location         Json
  name             Json
  description      Json
  longDescription  Json
  activities       Json
  accommodations   Json
  coverImage       String
  published        Boolean            @default(true)
  sortOrder        Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  images           DestinationImage[]
  trips            Trip[]
  lodgingOptions   Accommodation[]
  bookings         Booking[]

  @@index([published, sortOrder])
}

model DestinationImage {
  id            String      @id @default(cuid())
  destinationId String
  url           String
  alt           Json
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId, sortOrder])
}

model Trip {
  id                  String       @id @default(cuid())
  slug                String       @unique
  destinationId       String
  name                Json
  description         Json
  longDescription     Json
  durationDays        Int
  basePriceDzd        Decimal      @db.Decimal(12, 2)
  accommodationLabel  Json
  category            Json
  imageUrl            String
  activities          Json
  itinerary           Json         @default("[]")
  published           Boolean      @default(true)
  sortOrder           Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  destination         Destination  @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  bookings            Booking[]

  @@index([destinationId])
  @@index([published, sortOrder])
}

model Accommodation {
  id              String            @id @default(cuid())
  code            String            @unique
  type            AccommodationType
  name            Json
  description     Json
  pricePerNightDzd Decimal          @db.Decimal(12, 2)
  destinationId   String?
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  destination     Destination?      @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  bookings        Booking[]

  @@index([active])
}

model Activity {
  id               String            @id @default(cuid())
  code             String            @unique
  name             Json
  description      Json
  priceDzd         Decimal           @db.Decimal(12, 2)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  bookingActivities BookingActivity[]

  @@index([active])
}

model Transport {
  id              String    @id @default(cuid())
  code            String    @unique
  name            Json
  description     Json
  priceDzd        Decimal   @db.Decimal(12, 2) @default(0)
  emissionKgPerKm Decimal   @db.Decimal(10, 4) @default(0)
  forPlanner      Boolean   @default(true)
  forCarbon       Boolean   @default(true)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  bookings        Booking[]

  @@index([active])
}

model Booking {
  id                 String            @id @default(cuid())
  reference          String            @unique
  status             BookingStatus     @default(pending)
  customerName       String
  customerPhone      String
  customerEmail      String
  tripId             String?
  destinationId      String?
  accommodationId    String?
  transportId        String?
  plannerPayload     Json              @default("{}")
  travelers          Int
  nights             Int               @default(1)
  travelDate         DateTime          @db.Date
  estimatedTotalDzd  Decimal           @db.Decimal(12, 2)
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  trip               Trip?             @relation(fields: [tripId], references: [id], onDelete: SetNull)
  destination        Destination?      @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  accommodation      Accommodation?    @relation(fields: [accommodationId], references: [id], onDelete: SetNull)
  transport          Transport?        @relation(fields: [transportId], references: [id], onDelete: SetNull)
  activities         BookingActivity[]
  survey             BookingSurvey?

  @@index([status, createdAt])
  @@index([customerEmail])
}

model BookingActivity {
  id         String   @id @default(cuid())
  bookingId  String
  activityId String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@unique([bookingId, activityId])
}

model BookingSurvey {
  id                       String   @id @default(cuid())
  bookingId                String   @unique
  preferredTransport       String
  preferredAccommodation   String
  interestEcoActivities    Boolean
  environmentalAwareness   Int
  createdAt                DateTime @default(now())
  booking                  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model EmissionFactor {
  id          String   @id @default(cuid())
  code        String   @unique
  name        Json
  description Json
  kgPerKm     Decimal  @db.Decimal(10, 4)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, sortOrder])
}

model ContactMessage {
  id        String        @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  message   String
  status    MessageStatus @default(new)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}
